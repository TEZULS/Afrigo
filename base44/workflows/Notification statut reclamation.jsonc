{
  "name": "Notification statut réclamation",
  "description": "Notifie le client (cloche + push) quand le statut de sa réclamation change",
  "trigger": {
    "condition": "${ (.trigger.changed_fields | index(\"status\") != null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Return"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notification_statut_reclamation",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "createReturnStatusNotification",
            "args": {
              "entity_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end"
        }
      }
    ]
  }
}
