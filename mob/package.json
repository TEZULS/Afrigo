{
  "name": "afrigo-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start --dev-client",
    "start:emu": "node scripts/expo-start-dev.cjs emu",
    "start:localhost": "node scripts/expo-start-dev.cjs localhost",
    "android": "expo run:android",
    "android:winjdk": "node scripts/run-android-with-jdk.cjs",
    "android:bundle:release": "node scripts/gradle-bundle-release.cjs",
    "android:apk:local": "node scripts/gradle-assemble-local.cjs",
    "android:aab:local": "node scripts/gradle-bundle-local.cjs",
    "android:clean-native": "node scripts/clean-android-native.cjs",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild --clean",
    "lint": "eslint . --ext .ts,.tsx --quiet",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci",
    "build:android:preview": "eas build -p android --profile preview",
    "build:android:prod": "eas build -p android --profile production",
    "build:ios:preview": "eas build -p ios --profile preview",
    "build:ios:prod": "eas build -p ios --profile production",
    "submit:android": "eas submit -p android",
    "submit:ios": "eas submit -p ios",
    "eas:env:list": "eas env:list",
    "eas:env:list:prod": "eas env:list --environment production"
  },
  "dependencies": {
    "@base44/sdk": "^0.8.27",
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.0.6",
    "@hookform/resolvers": "^3.9.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.5.2",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/drawer": "^7.0.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "@shopify/flash-list": "2.0.2",
    "@stripe/stripe-react-native": "0.63.0",
    "@tanstack/react-query": "^5.84.1",
    "axios": "^1.7.7",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "expo": "~55.0.27",
    "expo-apple-authentication": "~55.0.14",
    "expo-application": "~55.0.16",
    "expo-background-fetch": "~55.0.20",
    "expo-build-properties": "~55.0.15",
    "expo-clipboard": "~55.0.14",
    "expo-constants": "~55.0.16",
    "expo-crypto": "~55.0.16",
    "expo-device": "~55.0.18",
    "expo-file-system": "~55.0.23",
    "expo-font": "~55.0.8",
    "expo-image": "~55.0.11",
    "expo-image-picker": "~55.0.21",
    "expo-linear-gradient": "~55.0.15",
    "expo-linking": "~55.0.16",
    "expo-localization": "~55.0.16",
    "expo-location": "~55.1.11",
    "expo-notifications": "~55.0.24",
    "expo-print": "~55.0.16",
    "expo-secure-store": "~55.0.15",
    "expo-sharing": "~55.0.21",
    "expo-splash-screen": "~55.0.22",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.19",
    "expo-task-manager": "~55.0.20",
    "expo-updates": "~55.0.25",
    "expo-web-browser": "~55.0.17",
    "lucide-react-native": "^0.468.0",
    "nativewind": "4.1.23",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.54.2",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-get-random-values": "^1.11.0",
    "react-native-maps": "1.27.2",
    "react-native-pager-view": "8.0.0",
    "react-native-qrcode-svg": "^6.3.12",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-toast-message": "^2.2.1",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.4",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.24.2",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.10",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^9.18.0",
    "eslint-config-expo": "~55.0.1",
    "eas-cli": "^20.5.1",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.19",
    "prettier": "^3.4.2",
    "react-test-renderer": "19.2.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "uuid": "8.3.2"
  },
  "resolutions": {
    "uuid": "8.3.2"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "clsx",
          "@base44/sdk"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|@gorhom/.*|@base44/.*|react-native-toast-message|@stripe/.*))"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/android/",
      "/ios/",
      "/.expo/",
      "test-utils\\.tsx$"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/**/index.ts"
    ]
  }
}
