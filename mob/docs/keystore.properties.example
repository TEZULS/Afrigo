# Copie : cp docs/keystore.properties.example android/keystore.properties
# Puis remplace les mots de passe par les mêmes que dans keytool (souvent identiques).
# Ne commite pas android/keystore.properties ni le .keystore.

storeFile=afrigo-release.keystore
storePassword=TON_MOT_DE_PASSE_KEYSTORE
keyAlias=afrigo
keyPassword=TON_MOT_DE_PASSE_CLÉ
