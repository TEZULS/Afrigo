{
  "expo": {
    "name": "AfriGo",
    "slug": "afrigo",
    "scheme": "afrigo",
    "version": "1.0.27",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-blank.png",
      "resizeMode": "contain",
      "backgroundColor": "#F9600C"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.afrigo.mobile",
      "buildNumber": "40",
      "config": {
        "usesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:afrigo.app"
      ],
      "infoPlist": {
        "NSCameraUsageDescription": "AfriGo utilise l'appareil photo pour rechercher des produits par image et photographier des retours.",
        "NSPhotoLibraryUsageDescription": "AfriGo a besoin d'accéder à vos photos pour la recherche par image et les preuves de retour.",
        "NSPhotoLibraryAddUsageDescription": "AfriGo enregistre vos QR codes et bordereaux de commande.",
        "NSMicrophoneUsageDescription": "AfriGo utilise le micro pour rechercher un produit à la voix.",
        "NSSpeechRecognitionUsageDescription": "AfriGo transforme votre voix en texte pour rechercher un produit par son nom.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "app.afrigo.mobile",
      "versionCode": 25,
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "afrigo.app",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-blank.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F9600C"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1",
            "useFrameworks": "static"
          },
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 35,
            "minSdkVersion": 24
          }
        }
      ],
      [
        "expo-secure-store"
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AfriGo souhaite accéder à vos photos pour la recherche par image et les preuves de retour.",
          "cameraPermission": "AfriGo souhaite accéder à votre appareil photo pour la recherche par image."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#F97316"
        }
      ],
      [
        "expo-updates",
        {
          "username": "afrigo"
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "enableGooglePay": true
        }
      ],
      "expo-font",
      "expo-background-fetch",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AfriGo utilise votre position pour vous proposer en premier les adresses proches de chez vous."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "AfriGo utilise le micro pour rechercher un produit à la voix.",
          "speechRecognitionPermission": "AfriGo transforme votre voix en texte pour rechercher un produit par son nom.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox", "com.google.android.tts"]
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "501b64d7-fd58-449d-8a1e-046a2d43e7d1"
      }
    },
    "owner": "afrigo",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/501b64d7-fd58-449d-8a1e-046a2d43e7d1",
      "fallbackToCacheTimeout": 0
    }
  }
}
