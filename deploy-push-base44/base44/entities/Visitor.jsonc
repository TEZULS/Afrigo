{
  "name": "Visitor",
  "type": "object",
  "properties": {
    "visitor_id": {
      "type": "string",
      "description": "Identifiant unique du visiteur (g\u00e9n\u00e9r\u00e9 automatiquement)"
    },
    "user_email": {
      "type": "string",
      "description": "Email de l'utilisateur si connect\u00e9"
    },
    "device_info": {
      "type": "string",
      "description": "Informations sur l'appareil (navigateur, OS)"
    },
    "visit_count": {
      "type": "number",
      "description": "Nombre de visites",
      "default": 1
    },
    "last_visit": {
      "type": "string",
      "format": "date-time",
      "description": "Date de la derni\u00e8re visite"
    },
    "first_visit": {
      "type": "string",
      "format": "date-time",
      "description": "Date de la premi\u00e8re visite"
    },
    "pages_visited": {
      "type": "array",
      "description": "Liste des pages visit\u00e9es",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "required": [
    "visitor_id"
  ],
  "rls": {
    "create": null,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}