{
  "name": "CartItem",
  "type": "object",
  "properties": {
    "customer_email": {
      "type": "string",
      "description": "Email du client"
    },
    "product_id": {
      "type": "string",
      "description": "ID du produit"
    },
    "product_name": {
      "type": "string"
    },
    "product_image": {
      "type": "string"
    },
    "quantity": {
      "type": "number",
      "description": "Quantit\u00e9"
    },
    "unit_price": {
      "type": "number"
    },
    "unit": {
      "type": "string"
    },
    "selected_variants": {
      "type": "object",
      "description": "Variantes s\u00e9lectionn\u00e9es (taille, forme, poids)",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "price_modifier": {
            "type": "number"
          }
        }
      }
    }
  },
  "required": [
    "customer_email",
    "product_id",
    "quantity"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}