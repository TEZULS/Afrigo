{
  "name": "Push – nouvel essai",
  "description": "Toutes les 15 minutes, renvoie les notifications push dont l’envoi a échoué (3 essais au plus)",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 15,
      "interval_unit": "minutes",
      "interval_anchor": "2026-10-11T00:00:00.000000",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "push_nouvel_essai",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "dispatchPushNotifications",
            "args": {
              "mode": "retry"
            }
          },
          "then": "end"
        }
      }
    ]
  }
}
